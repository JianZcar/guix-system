#!/usr/bin/env bash
set -e

nvidia=${1:-}
if [[ $# -gt 0 ]]; then shift; fi

nvidia_version=${1:-}
if [[ $# -gt 0 ]]; then shift; fi

packages=(
  bash
  coreutils
  glibc
  gcc-toolchain
  jemalloc
  mono

  # Utilities
  findutils
  grep
  sed
  gawk
  file
  which
  util-linux
  procps
  xz
  lz4
  zstd
  tar
  gzip
  unrar
  unzip
  7zip
  yad
  zenity
  cage

  gtk
  gtk+
  hicolor-icon-theme
  adwaita-icon-theme

  # Graphics
  mesa-utils
  vulkan-tools

  # Audio
  pipewire
  pulseaudio
  alsa-lib
  alsa-plugins
)

gpu_args=(--expose=/dev/dri)
preserve_args=()

if [[ "$nvidia" == "--nvidia" ]]; then
  packages+=(nvda@"$nvidia_version")
  gpu_args+=(
    --expose=/dev/nvidia0
    --expose=/dev/nvidiactl
    --expose=/dev/nvidia-modeset
    --expose=/dev/nvidia-uvm
  )
  preserve_args+=(
    --preserve='^__GLX_VENDOR_LIBRARY_NAME$'
    --preserve='^__NV_PRIME_RENDER_OFFLOAD$'
    --preserve='^__VK_LAYER_NV_optimus$'
  )
fi

guix shell \
  --container \
  --network \
  --emulate-fhs \
  --share="$HOME" \
  --share=/tmp/.X11-unix \
  --share="$XDG_RUNTIME_DIR" \
  "${gpu_args[@]}" \
  --expose=/dev/snd \
  --expose=/sys \
  --preserve='^HOME$' \
  --preserve='^WAYLAND_DISPLAY$' \
  --preserve='^XDG_RUNTIME_DIR$' \
  --preserve='^DISPLAY$' \
  --preserve='^XDG_SESSION_TYPE$' \
  --preserve='^DBUS_SESSION_BUS_ADDRESS$' \
  --preserve='^PULSE_SERVER$' \
  --preserve='^PIPEWIRE_REMOTE$' \
  --preserve='^XAUTHORITY$' \
  "${preserve_args[@]}" \
  "${packages[@]}" \
  -- "$@"
