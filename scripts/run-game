#!/usr/bin/env bash
set -e

nvidia=${1:-}
if [[ $# -gt 0 ]]; then shift; fi

nvidia_version=${1:-}
if [[ $# -gt 0 ]]; then shift; fi

packages=(
  # Base
  bash
  coreutils
  glibc

  # Development
  gcc-toolchain
  jemalloc
  mono

  # Utilities
  7zip
  file
  findutils
  gawk
  grep
  gzip
  lz4
  procps
  sed
  tar
  unrar
  unzip
  util-linux
  which
  xz
  zstd

  # GUI
  adwaita-icon-theme
  cage
  gtk
  gtk+
  hicolor-icon-theme
  yad
  zenity

  # Graphics
  mesa-utils
  vulkan-tools

  # Audio
  alsa-lib
  alsa-plugins
  pipewire
  pulseaudio
)

gpu_args=(--expose=/dev/dri)
preserve_args=()

if [[ "$nvidia" == "--nvidia" ]]; then
  packages+=(nvda@"$nvidia_version")
  gpu_args+=(
    --expose=/dev/nvidia0
    --expose=/dev/nvidiactl
    --expose=/dev/nvidia-modeset
    --expose=/dev/nvidia-uvm
  )
  preserve_args+=(
    --preserve='^__GLX_VENDOR_LIBRARY_NAME$'
    --preserve='^__NV_PRIME_RENDER_OFFLOAD$'
    --preserve='^__VK_LAYER_NV_optimus$'
  )
fi

guix shell \
  --container \
  --network \
  --emulate-fhs \
  --share="$HOME" \
  --share=/tmp/.X11-unix \
  --share="$XDG_RUNTIME_DIR" \
  "${gpu_args[@]}" \
  --expose=/dev/snd \
  --expose=/sys \
  --preserve='^HOME$' \
  --preserve='^WAYLAND_DISPLAY$' \
  --preserve='^XDG_RUNTIME_DIR$' \
  --preserve='^DISPLAY$' \
  --preserve='^XDG_SESSION_TYPE$' \
  --preserve='^DBUS_SESSION_BUS_ADDRESS$' \
  --preserve='^PULSE_SERVER$' \
  --preserve='^PIPEWIRE_REMOTE$' \
  --preserve='^XAUTHORITY$' \
  "${preserve_args[@]}" \
  "${packages[@]}" \
  -- "$@"
