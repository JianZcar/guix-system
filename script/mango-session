#!/bin/bash
set -u

dir=$(mktemp -d /tmp/XXXXXX) || exit 1
trap 'rm -rf "$dir"' EXIT

cat > "$dir/xterm" <<'EOF'
#!/usr/bin/env bash
exec footclient "$@"
EOF

chmod 700 "$dir"
chmod 700 "$dir/xterm"

export PATH="$PATH:$dir"
export XDG_DATA_DIRS="${XDG_DATA_DIRS:+$XDG_DATA_DIRS:}${HOME}/.local/share/flatpak/exports/share:/var/lib/flatpak/exports/share"
export XDG_CONFIG_DIRS="${XDG_CONFIG_DIRS:+$XDG_CONFIG_DIRS:}/etc/xdg"
export NOCTALIA_CONFIG_HOME="/etc/xdg"

export XDG_CURRENT_DESKTOP=mango
export XDG_SESSION_TYPE=wayland
export XDG_SESSION_DESKTOP=mango
export MOZ_ENABLE_WAYLAND=1
export QT_QPA_PLATFORM=wayland
export QT_QPA_PLATFORMTHEME=gtk3

export SSH_AUTH_SOCK="$HOME/.ssh/agent/ssh-agent.sock"
rm -f "$SSH_AUTH_SOCK"

flatpak --user remote-add --if-not-exists \
  flathub https://dl.flathub.org/repo/flathub.flatpakrepo

mkdir -p "$HOME/.ssh/agent" && \
  chmod 700 "$HOME/.ssh" && \
  chmod 700 "$HOME/.ssh/agent"

mkdir -p "$HOME/.config/foot/themes" && \
  touch "$HOME/.config/foot/themes/noctalia"

mkdir -p "$HOME/.config/mango" && \
  touch "$HOME/.config/mango/noctalia.conf"

ln -s /etc/xdg/mango/config.conf \
  "$HOME/.config/mango/config.conf" >/dev/null 2>&1

ln -s /etc/xdg/foot/foot.ini \
  "$HOME/.config/foot/foot.ini" >/dev/null 2>&1

runtime="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
shepherd_pidfile="$runtime/desktop-shepherd.pid"
shepherd_socket="$runtime/desktop-shepherd.socket"

mkdir -p "$HOME/.cache/mango"

cleanup() {
  herd -s "$shepherd_socket" stop shepherd || return

  rm -f "$shepherd_pidfile" "$shepherd_socket"
  rm -rf "$dir"
}

trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

dbus-run-session -- mango -s "dex -a" -c /etc/xdg/mango/base.conf
