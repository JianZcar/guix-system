#!/bin/bash
set -u

dir=$(mktemp -d /tmp/XXXXXX) || exit 1
trap 'rm -rf "$dir"' EXIT

cat > "$dir/xterm" <<'EOF'
#!/bin/sh
exec footclient "$@"
EOF

chmod 700 "$dir"
chmod 700 "$dir/xterm"

export PATH="$PATH:$dir"
export XDG_DATA_DIRS="${XDG_DATA_DIRS:+$XDG_DATA_DIRS:}${HOME}/.local/share/flatpak/exports/share:/var/lib/flatpak/exports/share"
export XDG_CONFIG_DIRS="${XDG_CONFIG_DIRS:+$XDG_CONFIG_DIRS:}/etc/xdg"
export NOCTALIA_CONFIG_HOME="/etc/xdg"

flatpak --user remote-add --if-not-exists \
  flathub https://dl.flathub.org/repo/flathub.flatpakrepo

mkdir -p "$HOME/.config/mango" && \
  ln -s /etc/xdg/mango/config.conf \
  "$HOME/.config/mango/config.conf" >/dev/null 2>&1

eval "$(ssh-agent -s)"

dbus-run-session -- bash <<'EOF'
pipewire &
pw_pid=$!

wireplumber &
wp_pid=$!

pipewire-pulse &
pulse_pid=$!

cleanup() {
    kill "$pulse_pid" "$wp_pid" "$pw_pid" 2>/dev/null
    wait "$pulse_pid" "$wp_pid" "$pw_pid" 2>/dev/null
}

trap cleanup EXIT

mkdir -p ~/.cache/mango
mango -s "dex -a" -c /etc/xdg/mango/base.conf >> ~/.cache/mango/mango.log 2>&1

pw-play /run/current-system/profile/share/sounds/Yaru/stereo/desktop-logoff.oga
EOF
